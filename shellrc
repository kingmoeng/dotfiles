# ~/.shellrc — bash / zsh 공통 설정
#
# 이 파일은 POSIX sh 문법만 사용한다. bash와 zsh 양쪽에서 source 되므로
# 배열, [[ ]], local 같은 셸 전용 문법을 쓰면 안 된다.
# 셸 전용 설정은 zshrc / .bashrc.d 쪽에 둘 것.

# ------------------------------------------------------------------ OS 판별
case "$(uname -s)" in
  Darwin) DOTFILES_OS=macos ;;
  Linux)
    if [ -n "${WSL_DISTRO_NAME:-}" ]; then
      DOTFILES_OS=wsl
    else
      DOTFILES_OS=linux
    fi
    ;;
  *) DOTFILES_OS=unknown ;;
esac
export DOTFILES_OS

# ------------------------------------------------------------------ PATH
# 이미 들어있으면 다시 넣지 않는다(중첩 셸에서 PATH가 불어나는 것 방지).
# 존재하지 않는 디렉터리는 조용히 건너뛴다.
_path_prepend() {
  [ -d "$1" ] || return 0
  case ":${PATH}:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

# Homebrew (macOS). shellenv가 PATH/MANPATH/INFOPATH를 알아서 잡아준다.
if [ "$DOTFILES_OS" = macos ]; then
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
  # Homebrew openjdk는 자동으로 PATH에 안 붙는다
  _path_prepend "/opt/homebrew/opt/openjdk@17/bin"
fi

_path_prepend "$HOME/bin"
_path_prepend "$HOME/.local/bin"   # uv, pipx 등
_path_prepend "$HOME/.bun/bin"

export PATH

# ------------------------------------------------------------------ 환경변수
export EDITOR=vim
export VISUAL="$EDITOR"
export LESS='-R'                    # less에서 색상 이스케이프 그대로 출력

# gpg 서명 시 pinentry가 올바른 터미널을 잡도록. 터미널이 있을 때만 설정.
if [ -t 0 ]; then
  GPG_TTY="$(tty)"
  export GPG_TTY
fi

export BUN_INSTALL="$HOME/.bun"

# ------------------------------------------------------------------ alias
# ls 색상 옵션은 BSD(macOS)와 GNU(Linux)가 다르다.
# GNU ls에서 -G는 "색상"이 아니라 "그룹 열 숨기기"이므로 그대로 쓰면 안 된다.
if [ "$DOTFILES_OS" = macos ]; then
  alias ls='ls -G'
else
  alias ls='ls --color=auto'
fi
alias ll='ls -lh'
alias la='ls -lha'
alias l='ls -CF'

alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'

alias python=python3
alias pip=pip3

# ------------------------------------------------------------------ 머신 전용
# 이 저장소에 넣으면 안 되는 것들(회사 설정, 토큰, 특정 머신 경로)은 여기에.
if [ -f "$HOME/.shellrc.local" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.shellrc.local"
fi
